CompileFlags:
    Add:
        - -DDEBUG
        - -Wno-reserved-user-defined-literal
        - -I.
        - -Ithird_party
---
If:
    PathMatch: [.*\.c]
CompileFlags:
    Add:
        - -xc
        - -std=c17
---
If:
    PathExclude: [.*\.c]
CompileFlags:
    Add:
        - -xc++
        - -std=c++20
---
Diagnostics:
    UnusedIncludes: None
    MissingIncludes: None
    ClangTidy:
        Remove: ["*"]

InlayHints:
    Enabled: false

Completion:
    HeaderInsertion: Never
